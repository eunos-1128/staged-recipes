# Make Laminar optional for distributions that cannot redistribute its proxy.
# Upstream discussion: https://github.com/OpenHands/software-agent-sdk/issues/5693
# This is a downstream patch, not an upstream-accepted change.
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -23,7 +23,6 @@
     "python-json-logger>=4.2.0",
     "tenacity>=9.1.2",
     "websockets>=12",
-    "lmnr>=0.7.60,<0.8.0",
     "tree-sitter>=0.26.1",
     "tree-sitter-bash>=0.25",
 ]
@@ -35,6 +34,7 @@
 "Bug Tracker" = "https://github.com/OpenHands/software-agent-sdk/issues"
 
 [project.optional-dependencies]
+observability = ["lmnr>=0.7.60,<0.8.0"]
 boto3 = ["boto3>=1.44.1"]
 toolshield = ["toolshield>=0.1.3,<0.2"]
 vertex = ["google-cloud-aiplatform>=2.8.0"]
--- a/openhands/sdk/observability/laminar.py
+++ b/openhands/sdk/observability/laminar.py
@@ -16,6 +16,7 @@
 import contextlib
 import functools
 import inspect
+import importlib.util
 import json
 import sys
 from collections.abc import Callable, Iterator, Mapping
@@ -356,6 +357,13 @@
     if _observability_enabled:
         return True
     if any(get_env(key) for key in _OBSERVABILITY_ENV_KEYS):
+        if importlib.util.find_spec("lmnr") is None:
+            raise RuntimeError(
+                "OpenHands tracing is enabled, but the optional 'lmnr' dependency "
+                "is not installed. Install openhands-sdk[observability] in an "
+                "environment that provides it, or unset the tracing variables: "
+                + ", ".join(_OBSERVABILITY_ENV_KEYS)
+            )
         _observability_enabled = True
         return True
